{
  "name": "thematic-lens",
  "version": "0.1.1",
  "description": "Local-first desktop app for human-in-the-loop thematic analysis \u2014 curates the output of the thematic-analyser engine.",
  "author": {
    "name": "Michael Borck",
    "email": "michael.borck@curtin.edu.au"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -b -w src/main",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron . --no-sandbox",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -b src/main",
    "build:renderer": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-log": "^5.4.1",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^24.12.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "26.8.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^6.3.5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "org.locolab.thematic-lens",
    "productName": "Thematic Lens",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "public/**/*"
    ],
    "afterSign": "scripts/notarize.js",
    "publish": {
      "provider": "github",
      "owner": "michael-borck",
      "repo": "thematic-lens"
    },
    "mac": {
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
